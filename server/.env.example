# Copy to server/.env and fill in real values.

PORT=8000
NODE_ENV=development

MONGO_URI=your_mongodb_connection_string
DATABASE_URL=your_postgresql_connection_string
JWT_SECRET=your_jwt_secret

GOOGLE_APPLICATION_CREDENTIALS=./config/your_google_credentials.json
GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id

# --- Google Sign-In (OAuth 2.0) ---
# Create an "OAuth client ID" of type "Web application" at
# https://console.cloud.google.com/apis/credentials
#
# Under "Authorized redirect URIs" add exactly the value of
# GOOGLE_REDIRECT_URI below, and under "Authorized JavaScript origins"
# add CLIENT_URL. A mismatch of even a trailing slash is rejected by Google
# with redirect_uri_mismatch.
GOOGLE_CLIENT_ID=your_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_oauth_client_secret

# Where this API is reachable, used to build the callback URL.
SERVER_URL=http://localhost:8000
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# Where the browser is sent after a successful sign-in.
CLIENT_URL=http://localhost:5173
